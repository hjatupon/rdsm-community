<?xml version="1.0"?>
<robot name="xacro_if_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="has_arm" value="1"/>
  <xacro:property name="has_gripper" value="0"/>

  <link name="base_link"/>

  <xacro:if value="${has_arm}">
    <link name="arm_link"/>
    <joint name="arm_joint" type="revolute">
      <parent link="base_link"/>
      <child link="arm_link"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:if>

  <!-- This block should be excluded because has_gripper=0 -->
  <xacro:if value="${has_gripper}">
    <link name="gripper_link"/>
    <joint name="gripper_joint" type="fixed">
      <parent link="arm_link"/>
      <child link="gripper_link"/>
    </joint>
  </xacro:if>

  <!-- unless: opposite of if — included when value is falsy -->
  <xacro:unless value="${has_gripper}">
    <link name="end_effector_placeholder"/>
    <joint name="ee_joint" type="fixed">
      <parent link="base_link"/>
      <child link="end_effector_placeholder"/>
    </joint>
  </xacro:unless>
</robot>
